{
    "schemaVersion": 1,
    "id": "exp_fabric_testmod",
    "version": "${project.version}",
    "name": "Exp Fabric Test Mod",
    "environment": "*",
    "custom": {
        "mixinta": {
            "classes": ["love.crysh.exp.Main"],
            "mixins": ["love.crysh.exp.fabric.testmod.mixin.MainMixin"]
        }
