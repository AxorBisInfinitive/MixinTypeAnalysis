{
    "schemaVersion": 1,
    "id": "mixinta",
    "version": "${project.version}",
    "name": "Mixin Type Analysis",
    "authors": [
        "AxorBisInfinitive"
    ],
    "license": "MIT",
    "environment": "*",
    "languageAdapters": {
        "mixinta_bootstrap": "love.crysh.mixinta.runtime.RuntimeBootstrapAdapter"
    },
    "entrypoints": {
        "preLaunch": [
            "love.crysh.mixinta.runtime.RuntimePreLaunch"
        ],
        "main": [
